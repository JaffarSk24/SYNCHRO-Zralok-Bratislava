---
// Summer camps 2026 are over — instead of the sign-up pitch this block now shows
// "Ako to bolo": a video recap of the sessions (tiles link to Instagram reels).
import { events, kempyRecap, t } from "../i18n";
const c = events.camps;
---

<section id="kempy" class="relative bg-abyss py-20 md:py-28">
  <div class="glow-clip" aria-hidden="true">
    <div class="glow" style="width:520px;height:520px;background:#22d3ee;bottom:-180px;left:-120px;opacity:0.25"></div>
  </div>
  <div class="container-x relative">
    <div class="max-w-2xl" data-reveal>
      <p class="eyebrow mb-4"><span class="w-6 hairline"></span> {t.camps.eyebrow}</p>
      <h2 class="text-3xl md:text-5xl font-bold leading-[1.02]">{c.title}</h2>
      <p class="mt-4 font-display font-semibold text-xl text-cyan">{t.camps.recapH}</p>
      <p class="mt-3 text-muted text-lg leading-relaxed">{t.camps.recapText}</p>
    </div>

    <!-- Video recap tiles (link to Instagram reels) -->
    <div class="mt-10 grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4">
      {kempyRecap.map((r) => (
        <a
          href={r.permalink}
          target="_blank"
          rel="noopener"
          class="group"
          data-reveal
        >
          <div class="relative aspect-[3/4] rounded-2xl overflow-hidden border border-white/8">
            <img src={r.src} alt={`${r.title} – ${r.session}`} loading="lazy" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" />
            <div class="absolute inset-0" style="background:linear-gradient(to top, color-mix(in srgb,var(--color-abyss) 92%, transparent) 6%, transparent 55%)"></div>
            <!-- session chip -->
            <span class="absolute top-2.5 left-2.5 recap-chip">{r.session}</span>
            <!-- play hint -->
            <span class="absolute top-2.5 right-2.5 recap-play" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="w-3.5 h-3.5" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            </span>
            <div class="absolute bottom-0 inset-x-0 p-3">
              <div class="font-display font-semibold text-sm text-ink leading-snug">{r.title}</div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .recap-chip {
    display: inline-flex; align-items: center;
    font-size: .62rem; font-weight: 800; letter-spacing: .08em; text-transform: uppercase;
    padding: .3rem .55rem; border-radius: 999px; line-height: 1;
    color: var(--color-abyss);
    background: linear-gradient(135deg, var(--color-cyan), var(--color-wave));
  }
  .recap-play {
    display: grid; place-items: center;
    width: 1.6rem; height: 1.6rem; border-radius: 999px;
    color: var(--color-ink);
    background: color-mix(in srgb, var(--color-abyss) 55%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-ink) 18%, transparent);
    backdrop-filter: blur(4px);
  }
</style>
