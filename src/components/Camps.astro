---
import { events, t, LOCALE } from "../i18n";
const c = events.camps;

// Motivating "only N spots left" badge (localized). SK plural: 1 miesto,
// 2–4 miesta, 5+ miest; EN: 1 spot / N spots.
const spotsLabel = (n: number) => {
  if (LOCALE === "en") return `Only ${n} spot${n === 1 ? "" : "s"} left`;
  const w = n === 1 ? "miesto" : n >= 2 && n <= 4 ? "miesta" : "miest";
  return `Už len ${n} ${w}`;
};
const doneLabel = LOCALE === "en" ? "Completed" : "Ukončené";
---

<section id="kempy" class="relative bg-abyss py-20 md:py-28">
  <div class="glow-clip" aria-hidden="true">
    <div class="glow" style="width:520px;height:520px;background:#22d3ee;bottom:-180px;left:-120px;opacity:0.25"></div>
  </div>
  <div class="container-x relative grid lg:grid-cols-[0.95fr_1.05fr] gap-10 items-center">
    <div data-reveal>
      <p class="eyebrow mb-4"><span class="w-6 hairline"></span> {t.camps.eyebrow}</p>
      <h2 class="text-3xl md:text-5xl font-bold leading-[1.02]">{c.title}</h2>
      <p class="mt-5 text-muted text-lg leading-relaxed">{c.description}</p>

      <ul class="mt-7 grid sm:grid-cols-2 gap-3">
        {c.includes.map((i) => (
          <li class="flex items-start gap-2.5 text-sm">
            <span class="flex-none mt-0.5 text-cyan">
              <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span class="text-muted">{i}</span>
          </li>
        ))}
      </ul>

      <div class="mt-8 flex flex-wrap items-center gap-4">
        <a href={c.ctaUrl} target="_blank" rel="noopener" class="btn btn-primary">{c.ctaLabel}</a>
        <div class="leading-tight">
          <span class="font-display font-bold text-2xl">{c.price}</span>
          <span class="text-muted text-sm">{c.priceNote}</span>
        </div>
      </div>
    </div>

    <div class="card p-6 md:p-8" data-reveal>
      <div class="flex items-center justify-between text-sm text-muted">
        <span>{c.audience}</span>
        <span>{c.location}</span>
      </div>
      <div class="hairline my-5"></div>

      <h3 class="font-display font-semibold text-lg mb-4">{t.camps.datesH}</h3>
      <ul class="space-y-3">
        {c.sessions.map((s, i) => {
          const spots = (s as any).spotsLeft as number | undefined;
          const done = (s as any).done as boolean | undefined;
          const soldOut = (s as any).soldOut as boolean | undefined;
          const muted = done || soldOut;
          return (
            <li class:list={["relative flex flex-wrap items-center gap-x-4 gap-y-2 p-4 rounded-xl border transition-colors", soldOut ? "sold-row border-white/5" : done ? "done-row border-white/5" : "bg-white/[0.03] border-white/5 hover:border-cyan/30"]}>
              <span
                class="flex-none grid place-items-center w-10 h-10 rounded-full font-display font-bold text-abyss"
                style={muted ? "background:linear-gradient(135deg,#94a3b8,#64748b)" : "background:linear-gradient(135deg,var(--color-cyan),var(--color-wave))"}
              >{i + 1}</span>
              <div class:list={["flex-1 min-w-0", { "opacity-55": done, "opacity-70": soldOut }]}>
                <div class:list={["font-semibold", { "line-through decoration-white/40": soldOut }]}>{s.dates}</div>
                {!soldOut && <div class="text-xs text-muted">{s.label} · {c.schedule}</div>}
              </div>
              {soldOut ? (
                <span class="sold-badge ml-auto"><span class="sold-dot" aria-hidden="true"></span>Sold out</span>
              ) : done ? (
                <span class="done-badge ml-auto">
                  <svg viewBox="0 0 24 24" class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 13l4 4L19 7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  {doneLabel}
                </span>
              ) : spots ? (
                <span class="spots-badge ml-auto"><span class="spots-dot" aria-hidden="true"></span>{spotsLabel(spots)}</span>
              ) : null}
            </li>
          );
        })}
      </ul>
      <p class="mt-5 text-xs text-muted/80">{t.camps.note}</p>
    </div>
  </div>
</section>

<style>
  /* "Only N spots left" — motivating, warm gold urgency */
  .spots-badge {
    display: inline-flex; align-items: center; gap: .45rem;
    font-size: .68rem; font-weight: 800; letter-spacing: .06em; text-transform: uppercase;
    padding: .38rem .72rem; border-radius: 999px; white-space: nowrap; line-height: 1;
    color: #fff7e0;
    background: linear-gradient(135deg, color-mix(in srgb, #fbbf24 30%, transparent), color-mix(in srgb, #f59e0b 24%, transparent));
    border: 1px solid color-mix(in srgb, #fbbf24 55%, transparent);
    box-shadow: 0 6px 18px -8px color-mix(in srgb, #f59e0b 70%, transparent);
  }
  .spots-dot {
    width: .42rem; height: .42rem; border-radius: 999px; flex: none;
    background: #fbbf24; box-shadow: 0 0 0 3px color-mix(in srgb, #fbbf24 28%, transparent);
    animation: spots-pulse 1.6s ease-in-out infinite;
  }
  @keyframes spots-pulse { 0%, 100% { opacity: 1; } 50% { opacity: .35; } }
  @media (prefers-reduced-motion: reduce) { .spots-dot { animation: none; } }

  /* Sold-out camp session */
  .sold-row { background: color-mix(in srgb, #e11d48 7%, transparent); }
  .sold-badge {
    display: inline-flex; align-items: center; gap: .45rem;
    font-size: .68rem; font-weight: 800; letter-spacing: .11em; text-transform: uppercase;
    padding: .38rem .72rem; border-radius: 999px; white-space: nowrap; line-height: 1;
    color: #ffe4e6;
    background: linear-gradient(135deg, color-mix(in srgb, #fb7185 28%, transparent), color-mix(in srgb, #e11d48 22%, transparent));
    border: 1px solid color-mix(in srgb, #fb7185 48%, transparent);
    box-shadow: 0 6px 18px -8px color-mix(in srgb, #e11d48 70%, transparent);
  }
  .sold-dot {
    width: .42rem; height: .42rem; border-radius: 999px; flex: none;
    background: #fb7185; box-shadow: 0 0 0 3px color-mix(in srgb, #fb7185 25%, transparent);
  }

  /* Completed (past) camp session — muted / greyed out */
  .done-row { background: color-mix(in srgb, #94a3b8 6%, transparent); }
  .done-badge {
    display: inline-flex; align-items: center; gap: .35rem;
    font-size: .68rem; font-weight: 700; letter-spacing: .07em; text-transform: uppercase;
    padding: .34rem .68rem; border-radius: 999px; white-space: nowrap; line-height: 1;
    color: #cbd5e1;
    background: color-mix(in srgb, #94a3b8 14%, transparent);
    border: 1px solid color-mix(in srgb, #94a3b8 32%, transparent);
  }
</style>
